# Caddyfile for the optional TLS proxy in front of qwbe-invoicing.
# Used only with `docker compose -f compose.prod.yaml --profile proxy up -d`.
# Copy it to `Caddyfile` next to compose.prod.yaml and replace invoice.example.com
# with the host of PUBLIC_ORIGIN (they must match exactly). Keep the target `app:3000`:
# the one image serves the UI and /api on that port, on the Compose network only.

invoice.example.com {
  encode zstd gzip
  # The kernel pins Host and X-Forwarded-Proto to PUBLIC_ORIGIN: both are passed as
  # the browser sent them, and anything else answers 400.
  reverse_proxy app:3000 {
    header_up Host {host}
    header_up X-Forwarded-Proto {scheme}
  }
  # `defer`: applied when the response is written, so these replace the same headers
  # the application already sends (HSTS included) instead of being sent twice.
  header {
    defer
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }
}
