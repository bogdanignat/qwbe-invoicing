APP_DOMAIN=invoice.test
IMAGE_TAG=local
# Production: pin by digest from image-digests.txt, e.g. IMAGE_TAG=0.3.0@sha256:<digest>
# ghcr.io/bogdanignat/qwbe-invoicing:<version> (linux/amd64, linux/arm64) — GHCR is canonical
# The Next frontend is a second image on the same version, pinned by its own digest
# (production only; locally both images use IMAGE_TAG):
#   FRONTEND_IMAGE_TAG=0.3.0@sha256:<frontend-digest>
# The public origin of the Next frontend. Locally compose.yaml derives it from
# APP_DOMAIN and ignores this variable; compose.prod.yaml requires it, with no
# fallback — set the real public origin there, never copy this example unedited:
#   FRONTEND_ORIGIN=https://invoice.example.com
ORGANIZATION_ID=local-organization
# Optional plugins (payments, efactura, company-lookup), comma-separated. Leave it
# commented to run all; an empty value runs none; an unknown name stops the application at startup.
# A change takes a restart.
#   QWBE_PLUGINS=payments,efactura,company-lookup
AUTH_TOKEN_PATH=./.local/api-token
DATA_VOLUME_NAME=qwbe-invoicing-data
# PostgreSQL: the password file the app and the server both read, and the name of
# the cluster volume. Both are NEW; the cluster is created fresh at first start.
# The operator creates the file; it is never in this repository, never in the image
# and never passed as PGPASSWORD:
#   install -d -m 700 .local && umask 077
#   openssl rand -hex 32 > .local/pg-password
PG_PASSWORD_PATH=./.local/pg-password
# Company lookup: the master key that encrypts the openapi.ro key at rest, 64 hex
# characters. Same rules as the password file; never regenerate it while a key is stored:
#   openssl rand -hex 32 > .local/company-lookup-key
COMPANY_LOOKUP_KEY_PATH=./.local/company-lookup-key
PG_VOLUME_NAME=qwbe-invoicing-postgres
# Backup/restore staging (TMPDIR inside the container is /var/backups/staging).
BACKUP_STAGING_VOLUME_NAME=qwbe-invoicing-backup-staging
# Production host example — compose.prod.yaml requires all three, with no fallback:
#   AUTH_TOKEN_PATH=/opt/qwbe-invoicing/secrets/api-token
#   PG_PASSWORD_PATH=/opt/qwbe-invoicing/secrets/pg-password
#   COMPANY_LOOKUP_KEY_PATH=/opt/qwbe-invoicing/secrets/company-lookup-key
# Next preview (compose.preview.yaml, profile `preview`) — its own cluster, its own
# volumes and its own secrets, all required with no fallback:
#   PREVIEW_AUTH_TOKEN_PATH=./.local/preview-api-token
#   PREVIEW_PG_PASSWORD_PATH=./.local/preview-pg-password
#   PREVIEW_COMPANY_LOOKUP_KEY_PATH=./.local/preview-company-lookup-key
#   PREVIEW_PORT=3181
