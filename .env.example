# qwbe-invoicing: Docker Compose settings.
#
# Copy this file to `.env` next to the compose file and fill it in. Compose reads it
# for variable interpolation only: it never enters the image, and `.env` is ignored by
# git and by the Docker build. No secret goes in here, only the paths of secret files.
#
#   self-host:          compose.prod.yaml        (README, "Quick start (self-host)")
#   local development:  compose.yaml with Warden (docs/LOCAL_DEVELOPMENT.md; last section)
#
# [required]  compose.prod.yaml refuses to start without it (no fallback).
# [optional]  the default is shown and is safe.

# ---- Public address ------------------------------------------------------------
# [required] The one origin the browser uses: scheme and host (and the port, if it is
# not 443), no path and no trailing slash. The application refuses every request whose
# Host, X-Forwarded-Host/-Proto or, on writes, Origin does not match it, so it must be
# exactly what users type. The Caddyfile host, or your own proxy's server name, is its host.
PUBLIC_ORIGIN=https://invoice.example.com

# ---- Image ---------------------------------------------------------------------
# [optional] The image repository, without a tag. compose.prod.yaml defaults to the
# project's published image (ghcr.io/bogdanignat/qwbe-invoicing). This example uses an
# image built from your checkout instead, which needs no registry:
#   docker build -t qwbe-invoicing:local .
# A published release, or your own registry or mirror, works the same way, e.g.
#   QWBE_IMAGE=ghcr.io/<owner>/qwbe-invoicing
QWBE_IMAGE=qwbe-invoicing
# [required] The tag. `local` for the build above; for a published release, pin the
# digest from its image-digests.txt, e.g. IMAGE_TAG=0.3.0@sha256:<digest>
IMAGE_TAG=local

# ---- Organization --------------------------------------------------------------
# [optional, default local-organization; set it in production] The internal, stable id
# of the company this installation serves, e.g. `hint` or `ro12345678`. Every record is
# scoped to it, the ANAF tokens included. It is not a secret and is printed on no
# invoice, PDF or XML (the issuer's name and CIF come from the settings in the UI).
# The application only refuses an empty value; use lowercase letters, digits and
# hyphens, no spaces. Choose it once, before the first start, and never change it:
# records stored under the old id would no longer be found, and a restore needs the same id.
ORGANIZATION_ID=example-organization

# ---- Database and artifact volume ---------------------------------------------
# [required] The database `app` and `migrate` use, and the volume holding the PDFs.
# Keep these values at install. scripts/production/restore.sh restores into a new pair
# and switches both here, in one write; the previous pair stays as it was.
QWBE_PGDATABASE=qwbe_invoicing
QWBE_DATA_VOLUME=qwbe-invoicing-data

# ---- Production scripts (scripts/production/) ----------------------------------
# [required by deploy.sh, backup.sh and restore.sh; Compose does not read them]
# Where backups are written: an absolute path outside the checkout, created by the
# operator, writable by the user running the scripts and by the image's user (node,
# uid 1000), e.g. `sudo install -d -m 0770 -o "$USER" -g 1000 /var/backups/qwbe-invoicing`.
# Archives stay on this host; copying them elsewhere is the server administrator's job.
BACKUP_DIR=/var/backups/qwbe-invoicing

# ---- Secret files --------------------------------------------------------------
# [required] Six files, created once. Relative paths are resolved from this file's
# directory; `.local/` is ignored by git and by the Docker build. They are mounted as
# Docker secrets and never passed as environment variables.
# Recommended, from the repository root after `cp .env.example .env` (it reads the
# paths below, never overwrites an existing file and prints no secret):
#   scripts/init-secrets.sh
# The same by hand, for the default paths below: 32 random bytes as 64 hex characters,
# `.local` 0700, each file 0600, an existing file kept, nothing printed (unlike the
# script, it does not inspect an existing file: an empty one or a symlink is kept as is):
#   mkdir -p -m 700 .local
#   ( umask 077; set -C; [ -e .local/api-token ] || printf '%s\n' "$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')" > .local/api-token )
#   ( umask 077; set -C; [ -e .local/pg-superuser-password ] || printf '%s\n' "$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')" > .local/pg-superuser-password )
#   ( umask 077; set -C; [ -e .local/pg-owner-password ] || printf '%s\n' "$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')" > .local/pg-owner-password )
#   ( umask 077; set -C; [ -e .local/pg-app-password ] || printf '%s\n' "$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')" > .local/pg-app-password )
#   ( umask 077; set -C; [ -e .local/company-lookup-key ] || printf '%s\n' "$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')" > .local/company-lookup-key )
#   ( umask 077; set -C; [ -e .local/anaf-token-key ] || printf '%s\n' "$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')" > .local/anaf-token-key )
# The ANAF client secret is not generated: README, "e-Factura with ANAF".
# Never regenerate them while the database exists: PostgreSQL keeps the superuser password
# it was created with (rotating the three: README, "Database access"), a new company-lookup
# key makes the stored openapi.ro key unreadable, and a new ANAF token key makes the stored
# ANAF tokens unreadable (reconnect with the certificate).
# The API token: unlocks the UI and authenticates the internal CLI/API.
AUTH_TOKEN_PATH=./.local/api-token
# The PostgreSQL passwords, one per role (deploy/postgres/grants.sql): `postgres`, the
# superuser (db and db-init only, never the application); qwbe_owner, the schema owner
# (migrate, restore); qwbe_app, DML only (app). db-init sets the last two at every start.
PG_SUPERUSER_PASSWORD_PATH=./.local/pg-superuser-password
PG_OWNER_PASSWORD_PATH=./.local/pg-owner-password
PG_APP_PASSWORD_PATH=./.local/pg-app-password
# The company-lookup master key (64 hex characters): encrypts the openapi.ro key at rest.
COMPANY_LOOKUP_KEY_PATH=./.local/company-lookup-key
# The ANAF token key (64 hex characters): encrypts the ANAF e-Factura tokens at rest. Read only
# with compose.anaf.yaml, but created with the others so enabling e-Factura needs no new key.
ANAF_TOKEN_KEY_PATH=./.local/anaf-token-key

# ---- ANAF e-Factura (optional) -------------------------------------------------
# [optional, default test] The ANAF environment: `test` (https://api.anaf.ro/test) unless
# `prod` is written out. Recorded on every connection and submission, so the two
# environments never mix. Any other value stops the application at startup.
#   ANAF_ENVIRONMENT=test
# The OAuth client registered in ANAF's portal (docs/LOCAL_DEVELOPMENT.md, "ANAF e-Factura"),
# enabled by the overlay below. With it all four values are required, and a partial setup
# stops the application at startup. The client secret is a file you create yourself (0600):
#   COMPOSE_FILE=compose.yaml:compose.anaf.yaml        (self-host: compose.prod.yaml:compose.anaf.yaml)
#   ANAF_CLIENT_ID=<client id from the ANAF portal>
#   ANAF_REDIRECT_URI=https://invoice.example.com/api/anaf/callback
#   ANAF_CLIENT_SECRET_PATH=./.local/anaf-client-secret

# ---- TLS and port --------------------------------------------------------------
# No port is published by default. Pick one way in (README, "Quick start (self-host)"):
#  - the bundled Caddy: `--profile proxy`; it publishes 80/443 and needs a Caddyfile
#    (copy Caddyfile.example, set the host of PUBLIC_ORIGIN);
#  - a reverse proxy already on this host: add `-f compose.loopback.yaml`, which
#    publishes the application on 127.0.0.1 only, on this port:
# [required with compose.loopback.yaml] A free port on the host's loopback interface.
#   APP_LOOPBACK_PORT=3180
#
# [optional] Instead of `-f`/`--profile` on every command, Compose reads these here:
#   COMPOSE_FILE=compose.prod.yaml:compose.loopback.yaml
# or, with the bundled Caddy:
#   COMPOSE_FILE=compose.prod.yaml
#   COMPOSE_PROFILES=proxy

# ---- Features ------------------------------------------------------------------
# [optional, default: all] Optional plugins (payments, efactura, company-lookup),
# comma-separated. Commented out runs all; an empty value runs none; an unknown name
# stops the application at startup. A change takes a restart.
#   QWBE_PLUGINS=payments,efactura,company-lookup
# [optional, default off] `on` serves the Bearer API on the same public listener as the
# browser. Off, any Authorization header is refused. On, a request with both a session
# cookie and Authorization is still refused, and writes still need `Origin: <PUBLIC_ORIGIN>`.
#   QWBE_BEARER_API=off
# [optional, default: the project network] The reverse proxies whose X-Forwarded-For keys
# the login throttle: comma-separated addresses or CIDR ranges. compose.prod.yaml trusts
# its own network, the two subnets below: the bundled Caddy and a proxy on this host
# (through compose.loopback.yaml) both reach the application from it. Such a proxy must
# overwrite X-Forwarded-For with the address it received the request from: Caddy and
# Traefik do, nginx with `proxy_set_header X-Forwarded-For $remote_addr;`. Not
# $proxy_add_x_forwarded_for: it keeps what the client sent, and an unreadable value
# there (`unknown`, `1.2.3.4:5678`) answers 400. For a proxy that cannot overwrite it,
# set it empty: nobody is trusted and every client shares the proxy's throttle bucket.
# Upgrading from an older .env: delete a value naming the old network (172.18.0.0/16).
#   QWBE_TRUSTED_PROXY=
# [optional, defaults 10.93.0.0/24 and fd93:1c5e:a7b0::/64] The fixed subnets of
# compose.prod.yaml's network: IPv4 outside Docker's default pools, IPv6 a ULA. Change one
# only if `up` says it overlaps a network of this host; QWBE_TRUSTED_PROXY follows them
# unless set on its own. A change takes `docker compose down` (no -v), then `up -d`.
#   QWBE_NETWORK_SUBNET=10.93.0.0/24
#   QWBE_NETWORK_SUBNET_IPV6=fd93:1c5e:a7b0::/64
# IPv6 on the project network: with Docker 27+ and ip6tables (the default) the bundled
# Caddy sees IPv6 visitors' real addresses; without ip6tables they arrive from the gateway
# and share one throttle bucket. Only on a host without IPv6, drop it with the overlay:
#   COMPOSE_FILE=compose.prod.yaml:compose.ipv4-only.yaml

# ---- Local development only (compose.yaml, Warden) -----------------------------
# compose.yaml derives the origin from APP_DOMAIN (https://<APP_DOMAIN>) and ignores
# PUBLIC_ORIGIN and QWBE_IMAGE; it builds qwbe-invoicing:${IMAGE_TAG} itself.
#   APP_DOMAIN=invoice.test
# Volume names (compose.prod.yaml uses fixed qwbe-invoicing-* names):
#   DATA_VOLUME_NAME=qwbe-invoicing-data
#   PG_VOLUME_NAME=qwbe-invoicing-postgres
#   BACKUP_STAGING_VOLUME_NAME=qwbe-invoicing-backup-staging
# The preview (compose.preview.yaml, profile `preview`): its own cluster, volumes and
# synthetic secrets, all three paths required, served on 127.0.0.1 only. Change the port
# and the origin together:
#   PREVIEW_AUTH_TOKEN_PATH=./.local/preview-api-token
#   PREVIEW_PG_PASSWORD_PATH=./.local/preview-pg-password
#   PREVIEW_COMPANY_LOOKUP_KEY_PATH=./.local/preview-company-lookup-key
#   PREVIEW_PORT=3181
#   PREVIEW_ORIGIN=http://invoicing-preview.localhost:3181
# UI work with the Vite dev server (compose.vite.yaml, docs/LOCAL_DEVELOPMENT.md).
# KERNEL_DEV_PORT is the loopback port the overlay publishes the kernel on (read here);
# QWBE_KERNEL_URL is where Vite proxies /api, read from the shell that runs
# `pnpm --filter @qwbe/invoicing-frontend dev`, not from this file. Change them together.
#   KERNEL_DEV_PORT=3000
#   QWBE_KERNEL_URL=http://127.0.0.1:3000
