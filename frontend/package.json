{
  "name": "@qwbe/invoicing-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "build": "next build --turbopack && node scripts/prepare-standalone.mjs",
    "start": "node --import ./scripts/validate-runtime.mjs .next/standalone/frontend/server.js",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.13",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
